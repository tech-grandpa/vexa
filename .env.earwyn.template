# Vexa Earwyn deployment — env vars
# Copy to /opt/earwyn/.env and fill in secrets

# Webex Bot
WEBEX_BOT_TOKEN=<your-webex-bot-token>
WEBEX_BOT_EMAIL=earwyn@webex.bot
WEBEX_WEBHOOK_SECRET=<generate-a-random-secret>

# Database (local postgres container)
DB_NAME=vexa
DB_USER=postgres
DB_PASSWORD=<generate-a-strong-password>

# Admin API token (shared secret for inter-service auth)
ADMIN_API_TOKEN=<generate-a-random-token>

# Remote transcriber
REMOTE_TRANSCRIBER_URL=http://10.10.10.199:8000
REMOTE_TRANSCRIBER_API_KEY=

# Bot image (built separately or same compose)
BOT_IMAGE_NAME=vexa-bot:latest

# Ports
API_GATEWAY_HOST_PORT=8056
TRANSCRIPTION_COLLECTOR_HOST_PORT=8123
TRANSCRIPT_ROOM_PORT=8790

# Logging
LOG_LEVEL=INFO

# Transcript room
TRANSCRIPT_ROOM_BASE_URL=http://10.10.10.135:8790
PUBLIC_BASE_URL=http://10.10.10.135:8056
